{
    "configurations": [
        {
            "name": "Launch via NPM",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "debug"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        
        {
            "name": "Host Core",
            "type": "debugpy",
            "request": "launch",
            "module": "core.main",
            "jinja": true,
            "console": "integratedTerminal"
        }
    ]
}